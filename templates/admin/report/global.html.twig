{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}

{% set total_sales_result = hookable_metadata.context.total_sales_result %}
{% set channel = hookable_metadata.context.channel %}

<h3>{{ 'monsieurbiz.sales_reports.ui.global_report'|trans }}</h3>
<table class="table table-bordered">
    <thead>
    <tr>
        <th>{{ 'monsieurbiz.sales_reports.view.amount_without_tax' | trans }}</th>
        <th>{{ 'monsieurbiz.sales_reports.view.promo_amount_without_tax' | trans }}</th>
        <th>{{ 'monsieurbiz.sales_reports.view.shipping_amount_without_tax' | trans }}</th>
        <th>{{ 'monsieurbiz.sales_reports.view.tax_amount' | trans }}</th>
        <th>{{ 'monsieurbiz.sales_reports.view.total_amount' | trans }}</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>{{ money.format(total_sales_result.without_tax_total, channel.baseCurrency.code) }}</td>
        <td>{{ money.format(total_sales_result.without_tax_promo_total, channel.baseCurrency.code) }}</td>
        <td>{{ money.format(total_sales_result.without_tax_shipping_total, channel.baseCurrency.code) }}</td>
        <td>{{ money.format(total_sales_result.tax_total, channel.baseCurrency.code) }}</td>
        <td>{{ money.format(total_sales_result.total, channel.baseCurrency.code) }}</td>
    </tr>
    </tbody>
</table>

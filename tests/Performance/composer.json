{
    "name": "monsieurbiz/sales-reports-benchmark",
    "description": "Isolated Sylius 1.14 report benchmark dependencies",
    "type": "project",
    "require": {
        "php": "^8.1",
        "sylius/core": "1.14.21",
        "doctrine/orm": "^2.20",
        "symfony/cache": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "MonsieurBiz\\SyliusSalesReportsPlugin\\": "../../src/"
        }
    },
    "config": {
        "allow-plugins": false,
        "audit": {
            "ignore": {
                "PKSA-w9tt-7782-78jx": "User-approved local benchmark only. No uploads or web server."
            }
        }
    }
}
